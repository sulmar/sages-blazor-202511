@page "/customers"
@using BlazorApp.Services
@inject ICustomerService Api


<h3>@message</h3>

<div>

    <DebounceSearchInput DebunceDelay="250" ValueChanged="@SearchAsync" />

    @*  <button @onclick="@SearchAsync">Search</button> *@

    <button @onclick="@ToggleTheme">
        Switch mode
    </button>

</div>


    <CascadingValue Value="@Title" Name="title">

        <CustomersTable Customers="@customers" Context="customer"  >
            <HeaderTemplate>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Nip</th>
                </tr>
            </HeaderTemplate>

            <RowTemplate>
                <tr>
                    <td>@customer.Name</td>
                    <td>@customer.Email</td>
                    <td>@customer.Nip</td>
                </tr>
            </RowTemplate>
        </CustomersTable>

    </CascadingValue>



@code {

    private string message = "Customer List";

    private IEnumerable<Customer>? customers = [];

    protected override async Task OnInitializedAsync()
    {
        customers = await Api.GetAll();
    }

    private Task SearchAsync(string searchText)
    {
        Console.WriteLine($"Searching customers by {searchText}...");

        return Task.CompletedTask;
    }

    private string Theme = "light";

    private void ToggleTheme()
    {
        Theme = Theme == "light" ? "dark" : "light";
    }

    private string Title = "Ilość";


}
