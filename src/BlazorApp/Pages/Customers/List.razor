@page "/customers"
@inject ICustomerRepository Repository

<h3>@message</h3>


<div>
    <input type="text" @bind-value="@searchText" @bind-value:after=@SearchHandler @bind-value:event="oninput" />
   @*  <button @onclick="@SearchAsync">Search</button> *@
</div>

<CustomersTable Customers="@customers" Context="customer" >
    <HeaderTemplate>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Nip</th>
        </tr>
    </HeaderTemplate>

    <RowTemplate>
        <tr>
            <td>@customer.Name</td>
            <td>@customer.Email</td>
            <td>@customer.Nip</td>
        </tr>
    </RowTemplate>
</CustomersTable>

@code {

    private CancellationTokenSource cts;

    private int DebunceDelay = 500;

    private string message = "Customer List";

    private string searchText = string.Empty;

    private IEnumerable<Customer> customers = [];

    protected override async Task OnInitializedAsync()
    {
        customers = await Repository.GetAllAsync();
    }
   
    private async Task SearchHandler()
    {
        cts?.Cancel();
        cts?.Dispose();

        cts = new CancellationTokenSource();

        CancellationToken token = cts.Token;

        try
        {
            // Debounce delay
            await Task.Delay(DebunceDelay, token);

            await SearchAsync(token);
        }
        catch(TaskCanceledException) {}
    }

    private Task SearchAsync(CancellationToken cancellationToken)
    {
        if (!cancellationToken.IsCancellationRequested)
        {
            Console.WriteLine($"Searching {searchText}...");            
        }

        return Task.CompletedTask;

    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }

}
