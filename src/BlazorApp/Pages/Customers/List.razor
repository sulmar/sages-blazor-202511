@page "/customers"
@using Domain.Abstractions
@using Domain.Models
@inject ICustomerRepository Repository

<h3>@message</h3>

<ul>
    @foreach (var customer in customers)
    {
        <li>@customer.Id @customer.Name @customer.Email @customer.Nip</li>
    }    
</ul>

@code {
    private string message = "Customer List";

    // [Inject]
    // ICustomerRepository Repository { get; set; }

    private IEnumerable<Customer> customers = [];

    protected override async Task OnInitializedAsync()
    {
        customers = await Repository.GetAllAsync();
    }



}
