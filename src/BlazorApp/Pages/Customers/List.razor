@page "/customers"
@inject ICustomerRepository Repository

<h3>@message</h3>

<CustomersTable Customers="@customers" Context="customer" >
    <HeaderTemplate>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Nip</th>
        </tr>
    </HeaderTemplate>

    <RowTemplate>
        <tr>
            <td>@customer.Name</td>
            <td>@customer.Email</td>
            <td>@customer.Nip</td>
        </tr>
    </RowTemplate>
</CustomersTable>

@code {
    private string message = "Customer List";

    private IEnumerable<Customer> customers = [];

    protected override async Task OnInitializedAsync()
    {
        customers = await Repository.GetAllAsync();
    }
   
}
