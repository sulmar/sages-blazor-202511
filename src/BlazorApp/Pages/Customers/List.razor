@page "/customers"
@inject ICustomerRepository Repository

<h3>@message</h3>


<div>
    <input type="text" @bind="@searchText" />
    <button @onclick="@SearchAsync">Search</button>
</div>

<CustomersTable Customers="@customers" Context="customer" >
    <HeaderTemplate>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Nip</th>
        </tr>
    </HeaderTemplate>

    <RowTemplate>
        <tr>
            <td>@customer.Name</td>
            <td>@customer.Email</td>
            <td>@customer.Nip</td>
        </tr>
    </RowTemplate>
</CustomersTable>

@code {
    private string message = "Customer List";

    private string searchText = string.Empty;

    private IEnumerable<Customer> customers = [];

    protected override async Task OnInitializedAsync()
    {
        customers = await Repository.GetAllAsync();
    }

    private Task SearchAsync()
    {
        Console.WriteLine($"Searching {searchText}...");

        return Task.CompletedTask;
    }

}
